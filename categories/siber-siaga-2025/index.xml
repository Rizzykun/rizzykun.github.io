srcset="https://rizzykun.github.io/p/siber-siaga-2025-finale/img-05_hu_487e07e45ccc4cf8.png 480w, https://rizzykun.github.io/p/siber-siaga-2025-finale/img-05_hu_7dc7d17be356b5a3.png 1024w, https://rizzykun.github.io/p/siber-siaga-2025-finale/img-05.png 1452w" sizes="(min-width: 1024px) 800px, 100vw"
